{
  "name": "@fffreire/regen",
  "version": "0.0.0",
  "description": "Resolve merge conflicts in generated files by rerunning their generators",
  "license": "MIT",
  "type": "module",
  "bin": {
    "regen": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test \"test/*.test.ts\"",
    "demo": "bash demo/run.sh"
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "typescript": "^7.0.2"
  }
}
